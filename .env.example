# OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=N0t-A-T0y-P@ssword!

# Database configuration
POSTGRES_DB=openiti
POSTGRES_USER=openiti
POSTGRES_PASSWORD=replace_me_with_real_password

# Processing mode: 'full' to ingest all texts, 'subset' to ingest a limited subset for testing
INGEST_MODE=subset
INGEST_ONLY_PRI=true
INGEST_LANGS=ara
INGEST_WORK_LIMIT=200
CHUNK_TARGET_WORDS=300
CHUNK_MAX_OVERLAP_WORDS=0
SKIP_EXISTING=false

# Embedding controls
EMBEDDINGS_ENABLED=true
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Search/vector storage names
OPENSEARCH_INDEX_CHUNKS=openiti_chunks
QDRANT_COLLECTION=openiti_chunks

# OpenSearch ingest tuning
OPENSEARCH_BULK_BATCH=500
